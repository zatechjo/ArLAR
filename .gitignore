# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
dev-server.err
dev-*.log
dev-*.err
*.log
*.err
.*.png
.tmp-*
/.tmp/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local admin persistence adapter (replaced by Supabase in production)
/.admin-data/

# Full-resolution ArLAR23 gallery is staged locally for Cloudflare upload.
# Keep the multi-gigabyte originals out of the Vercel deployment bundle.
/public/images/arlar23/gallery/Day 1/
/public/images/arlar23/gallery/Day 2/
/public/images/arlar23/gallery/Day 3/
/public/images/arlar23/gallery/Day 4/

# Production media is stored in Cloudflare R2; keep local copies out of Git.
/public/images/
/public/documents/
/public/Arab Flags/

# Supabase CLI working state is machine-specific.
/supabase/.temp/

.vercel
.env*
